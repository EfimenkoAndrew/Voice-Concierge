# Copy to .env and set REAL values. docker-compose reads .env.
# Never commit a populated .env (it is .gitignored). All secrets below are
# placeholders — compose fails fast if a required secret is unset.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voiceconcierge

# Backend connection string for LOCAL `dotnet run` (host port 5433 to avoid
# clashing with other local Postgres). Compose overrides this with
# Host=db;Port=5432 on the compose network automatically.
ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=voiceconcierge;Username=postgres;Password=postgres

# --- LiveKit ---
LIVEKIT_URL=wss://audiosupport-40zcfen6.livekit.cloud
LIVEKIT_API_KEY=APIZf5KDvE9Mkp6
LIVEKIT_API_SECRET=79JsIC7K4D6Jcl6oyZtfgi8dusMphcHofKo4Wv8koCy
LIVEKIT_ROOM=concierge

# React admin origin allowed by API CORS. Accepts a comma-separated list so a
# single-command demo works on the Vite dev server (5173), the nginx container
# port-mapping (5173:8080), and same-host deploys (8080).
UI_ORIGIN=http://localhost:5173,http://localhost:8080,http://localhost

# --- Provider profile: free | provided ---
PROFILE=free

# --- LLM / STT / TTS (only the voice agent needs these; see architecture §2).
#     Empty GROQ_API_KEY → agent speaks the FAQ answer verbatim (graceful). ---
LLM_PROVIDER=groq
GROQ_API_KEY=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
GOOGLE_API_KEY=
OPENAI_API_KEY=
STT_PROVIDER=groq
TTS_PROVIDER=edge

# Optional model integrity pins (SHA-256). If unset, downloads rely on TLS +
# pinned URLs only.
EMBEDDING_MODEL_SHA256=
VAD_MODEL_SHA256=
WHISPER_MODEL_SHA256=

# D4-09 / S4-01: allow runtime model fetches as fallback (NOT recommended in
# production — set true only for ad-hoc local development).
ALLOW_RUNTIME_WHISPER_DOWNLOAD=
ALLOW_RUNTIME_EMBEDDING_DOWNLOAD=

# --- Admin gate (optional, OFF by default per PRD scope). When set to a value
# ≥16 chars, mutation routes require it in the X-Admin-Key header.
ADMIN_API_KEY=xxxxxxxxxxxxxxxx
