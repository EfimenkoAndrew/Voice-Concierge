<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Agent-2b171985-00e7-45b0-85bf-098e74bf8b05</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="NLayer" />
    <PackageReference Include="SIPSorcery" />
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="protos/**/*.proto" ProtoRoot="protos" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VoiceConcierge.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoiceConcierge.Contracts\VoiceConcierge.Contracts.csproj" />
  </ItemGroup>
</Project>
